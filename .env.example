# ShadowTransfer — per-environment settings (single source of truth).
#
# Copy this file to `.env`, fill in the four values for your environment,
# then `source .env` before running any script (python or SLURM submit).
# Every path, account, and partition in the repo resolves from these vars.
#
#   cp .env.example .env
#   # edit .env
#   source .env

# Absolute path to the project root. The scripts expect data and outputs under
# $PROJECT_ROOT/data/... and the code/checkpoints under $PROJECT_ROOT/python/...
# Required by every .py and .sh script (submit wrappers fail loudly if unset).
export PROJECT_ROOT="/abs/path/to/shadowtransfer"

# SLURM account charged for jobs (sbatch -A / --account).
export SLURM_ACCOUNT="your_account"

# SLURM partition / queue to submit to (sbatch -p / --partition).
export SLURM_PARTITION="your_partition"

# Node(s) to exclude from scheduling (sbatch --exclude). Leave blank if none.
export NODE=""

# ---------------------------------------------------------------------------
# Camera-ready additions (crossearth/, sar/, bsm/, matched450/, appendix_h/,
# scoring/, probes/). Only ST_SCRATCH_ROOT is required by those scripts; the
# rest are needed solely by the SAR submit wrapper's cluster preflight.
# ---------------------------------------------------------------------------

# Writable working root for checkpoints, dumps and logs. On our cluster this is
# a separate high-capacity scratch volume; set it to $PROJECT_ROOT if you have
# only one filesystem.
export ST_SCRATCH_ROOT="${PROJECT_ROOT}"

# Root of the metric package import (`import shadowtransfer.metrics`). Defaults
# to the repository root, which is where shadowtransfer/ lives; override only if
# you relocate the package. Read by analysis/07 and analysis/gj_analysis.
export ST_METRICS_ROOT="${PROJECT_ROOT}"

# Allocation path whose quota the SAR submit preflight reads, and which it
# asserts is the same volume as ST_SCRATCH_ROOT. Leave blank to skip the gate.
# NOTE: the gate shells out to a site-specific quota tool; see sar/README.md.
export ST_QUOTA_ALLOC=""

# Archive-only tree that must never be a write target. Leave blank to disable
# the assertion.
export ST_ARCHIVE_ROOT=""

# Conda environment prefix, used only by the commented alternate-cluster blocks
# in the SAR worker.
export CONDA_ENV_PATH=""
